<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme using Material Design 3 -->
    <style name="Theme.TripTip_Yaron_and_Alon" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- First frame before content draws (avoids black flash on activity start) -->
        <item name="android:windowBackground">@color/background_beige</item>
        <!-- Primary Colors -->
        <item name="colorPrimary">@color/orange_primary</item>
        <item name="colorPrimaryVariant">@color/orange_dark</item>
        <item name="colorOnPrimary">@color/text_white</item>
        
        <!-- Secondary Colors -->
        <item name="colorSecondary">@color/turquoise</item>
        <item name="colorSecondaryVariant">@color/turquoise_dark</item>
        <item name="colorOnSecondary">@color/text_white</item>
        
        <!-- Background Colors -->
        <item name="android:colorBackground">@color/background_beige</item>
        <item name="colorSurface">@color/background_white</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnBackground">@color/text_primary</item>
        
        <!-- Error Colors -->
        <item name="colorError">@color/error</item>
        <item name="colorOnError">@color/text_white</item>
        
        <!-- Status Bar -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        
        <!-- Navigation Bar -->
        <item name="android:navigationBarColor">@color/background_white</item>
    </style>
    
    <!-- Dedicated splash screen theme: orange from the very first frame,
         before setContentView paints, so no beige flash is visible. -->
    <style name="Theme.TripTip.Splash" parent="Theme.TripTip_Yaron_and_Alon">
        <item name="android:windowBackground">@color/orange_primary</item>
        <item name="android:statusBarColor">@color/orange_primary</item>
        <item name="android:navigationBarColor">@color/orange_primary</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <!-- Button and Card styles moved to styles.xml to avoid duplicates -->
    
</resources>