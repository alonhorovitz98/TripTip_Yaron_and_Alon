<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Typography Styles for Stitch Design -->
    
    <!-- Headlines -->
    <style name="TextAppearance.TripTip.Headline1">
        <item name="android:textSize">@dimen/text_size_xxxl</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    
    <style name="TextAppearance.TripTip.Headline2">
        <item name="android:textSize">@dimen/text_size_xxl</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    
    <style name="TextAppearance.TripTip.Headline3">
        <item name="android:textSize">@dimen/text_size_xl</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    
    <!-- Body Text -->
    <style name="TextAppearance.TripTip.Body1">
        <item name="android:textSize">@dimen/text_size_large</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>
    
    <style name="TextAppearance.TripTip.Body2">
        <item name="android:textSize">@dimen/text_size_medium</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>
    
    <!-- Labels -->
    <style name="TextAppearance.TripTip.Label">
        <item name="android:textSize">@dimen/text_size_small</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    
    <!-- Captions - Note: TextAppearance.TripTip.Caption is also in styles.xml, keeping this one -->
    <!-- Removed duplicate to avoid conflict -->
    
    <!-- Button Text -->
    <style name="TextAppearance.TripTip.Button">
        <item name="android:textSize">@dimen/text_size_medium</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_white</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    
    <!-- Link Text -->
    <style name="TextAppearance.TripTip.Link">
        <item name="android:textSize">@dimen/text_size_medium</item>
        <item name="android:textColor">@color/orange_primary</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>
</resources>
