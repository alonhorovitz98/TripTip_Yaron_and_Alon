<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

    <!-- Auth Flow -->
    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.triptip_yaron_and_alon.ui.auth.LoginFragment"
        android:label="Login"
        tools:layout="@layout/fragment_login">
        <action
            android:id="@+id/action_loginFragment_to_registerFragment"
            app:destination="@id/registerFragment" />
        <action
            android:id="@+id/action_loginFragment_to_feedFragment"
            app:destination="@id/feedFragment" />
    </fragment>

    <fragment
        android:id="@+id/registerFragment"
        android:name="com.example.triptip_yaron_and_alon.ui.auth.RegisterFragment"
        android:label="Register"
        tools:layout="@layout/fragment_register">
        <action
            android:id="@+id/action_registerFragment_to_feedFragment"
            app:destination="@id/feedFragment" />
    </fragment>

    <!-- Main Flow -->
    <fragment
        android:id="@+id/feedFragment"
        android:name="com.example.triptip_yaron_and_alon.ui.feed.FeedFragment"
        android:label="Feed"
        tools:layout="@layout/fragment_feed">
        <action
            android:id="@+id/action_feedFragment_to_postDetailsFragment"
            app:destination="@id/postDetailsFragment">
            <argument
                android:name="postId"
                app:argType="string" />
        </action>
        <action
            android:id="@+id/action_feedFragment_to_createPostFragment"
            app:destination="@id/createPostFragment" />
        <action
            android:id="@+id/action_feedFragment_to_profileFragment"
            app:destination="@id/profileFragment" />
        <action
            android:id="@+id/action_feedFragment_to_tripListFragment"
            app:destination="@id/tripListFragment" />
    </fragment>

    <fragment
        android:id="@+id/postDetailsFragment"
        android:name="com.example.triptip_yaron_and_alon.ui.post.PostDetailsFragment"
        android:label="Post Details"
        tools:layout="@layout/fragment_post_details">
        <argument
            android:name="postId"
            app:argType="string" />
        <action
            android:id="@+id/action_postDetailsFragment_to_tripBuilderFragment"
            app:destination="@id/tripBuilderFragment">
            <argument
                android:name="tripId"
                app:argType="string"
                android:defaultValue="new" />
            <argument
                android:name="postId"
                app:argType="string" />
        </action>
    </fragment>

    <fragment
        android:id="@+id/createPostFragment"
        android:name="com.example.triptip_yaron_and_alon.ui.post.CreatePostFragment"
        android:label="Create Post"
        tools:layout="@layout/fragment_create_post">
        <action
            android:id="@+id/action_createPostFragment_to_feedFragment"
            app:destination="@id/feedFragment"
            app:popUpTo="@id/feedFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/editPostFragment"
        android:name="com.example.triptip_yaron_and_alon.ui.post.EditPostFragment"
        android:label="Edit Post"
        tools:layout="@layout/fragment_edit_post">
        <argument
            android:name="postId"
            app:argType="string" />
        <action
            android:id="@+id/action_editPostFragment_to_myPostsFragment"
            app:destination="@id/myPostsFragment"
            app:popUpTo="@id/myPostsFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/myPostsFragment"
        android:name="com.example.triptip_yaron_and_alon.ui.post.MyPostsFragment"
        android:label="My Posts"
        tools:layout="@layout/fragment_my_posts">
        <action
            android:id="@+id/action_myPostsFragment_to_editPostFragment"
            app:destination="@id/editPostFragment">
            <argument
                android:name="postId"
                app:argType="string" />
        </action>
        <action
            android:id="@+id/action_myPostsFragment_to_postDetailsFragment"
            app:destination="@id/postDetailsFragment">
            <argument
                android:name="postId"
                app:argType="string" />
        </action>
    </fragment>

    <!-- Trip Flow -->
    <fragment
        android:id="@+id/tripListFragment"
        android:name="com.example.triptip_yaron_and_alon.ui.trip.TripListFragment"
        android:label="My Trips"
        tools:layout="@layout/fragment_trip_list">
        <action
            android:id="@+id/action_tripListFragment_to_tripBuilderFragment"
            app:destination="@id/tripBuilderFragment">
            <argument
                android:name="tripId"
                app:argType="string" />
            <argument
                android:name="postId"
                app:argType="string"
                app:nullable="true" />
        </action>
        <action
            android:id="@+id/action_tripListFragment_to_tripDetailsFragment"
            app:destination="@id/tripDetailsFragment">
            <argument
                android:name="tripId"
                app:argType="string" />
        </action>
    </fragment>

    <fragment
        android:id="@+id/tripDetailsFragment"
        android:name="com.example.triptip_yaron_and_alon.ui.trip.TripDetailsFragment"
        android:label="Trip Details"
        tools:layout="@layout/fragment_trip_details">
        <argument
            android:name="tripId"
            app:argType="string" />
        <action
            android:id="@+id/action_tripDetailsFragment_to_tripDayEditorFragment"
            app:destination="@id/tripDayEditorFragment">
            <argument
                android:name="tripId"
                app:argType="string" />
            <argument
                android:name="dayId"
                app:argType="string" />
        </action>
        <action
            android:id="@+id/action_tripDetailsFragment_to_tripBuilderFragment"
            app:destination="@id/tripBuilderFragment">
            <argument
                android:name="tripId"
                app:argType="string" />
            <argument
                android:name="postId"
                app:argType="string"
                app:nullable="true" />
        </action>
    </fragment>

    <fragment
        android:id="@+id/tripBuilderFragment"
        android:name="com.example.triptip_yaron_and_alon.ui.trip.TripBuilderFragment"
        android:label="Trip Builder"
        tools:layout="@layout/fragment_trip_builder">
        <argument
            android:name="tripId"
            app:argType="string"
            android:defaultValue="new" />
        <argument
            android:name="postId"
            app:argType="string"
            app:nullable="true" />
        <action
            android:id="@+id/action_tripBuilderFragment_to_tripDayEditorFragment"
            app:destination="@id/tripDayEditorFragment">
            <argument
                android:name="tripId"
                app:argType="string" />
            <argument
                android:name="dayId"
                app:argType="string" />
        </action>
    </fragment>

    <fragment
        android:id="@+id/tripDayEditorFragment"
        android:name="com.example.triptip_yaron_and_alon.ui.trip.TripDayEditorFragment"
        android:label="Edit Day"
        tools:layout="@layout/fragment_trip_day_editor">
        <argument
            android:name="tripId"
            app:argType="string" />
        <argument
            android:name="dayId"
            app:argType="string" />
    </fragment>

    <!-- Profile Flow -->
    <fragment
        android:id="@+id/profileFragment"
        android:name="com.example.triptip_yaron_and_alon.ui.profile.ProfileFragment"
        android:label="Profile"
        tools:layout="@layout/fragment_profile">
        <action
            android:id="@+id/action_profileFragment_to_editProfileFragment"
            app:destination="@id/editProfileFragment" />
        <action
            android:id="@+id/action_profileFragment_to_myPostsFragment"
            app:destination="@id/myPostsFragment" />
        <action
            android:id="@+id/action_profileFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/editProfileFragment"
        android:name="com.example.triptip_yaron_and_alon.ui.profile.EditProfileFragment"
        android:label="Edit Profile"
        tools:layout="@layout/fragment_edit_profile">
        <action
            android:id="@+id/action_editProfileFragment_to_profileFragment"
            app:destination="@id/profileFragment"
            app:popUpTo="@id/profileFragment"
            app:popUpToInclusive="true" />
    </fragment>

</navigation>

