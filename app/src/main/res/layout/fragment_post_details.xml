<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Top Image Section (40% of screen) -->
            <FrameLayout
                android:id="@+id/imageSection"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHeight_percent="0.4">

                <!-- Post Image -->
                <ImageView
                    android:id="@+id/ivPostImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:background="@color/background_light" />

                <!-- Overlay Icons -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="16dp"
                    android:paddingBottom="16dp">

                    <!-- Back Arrow (circular white button) -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnBack"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:insetLeft="0dp"
                        android:insetRight="0dp"
                        android:backgroundTint="@color/background_white"
                        app:icon="@drawable/ic_arrow_back"
                        app:iconTint="@color/text_primary"
                        app:cornerRadius="20dp"
                        app:iconSize="24dp"
                        style="@style/Widget.Material3.Button" />

                    <!-- Spacer -->
                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <!-- Share Icon (circular white button) -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnShare"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:insetLeft="0dp"
                        android:insetRight="0dp"
                        android:backgroundTint="@color/background_white"
                        app:icon="@drawable/ic_paper_airplane"
                        app:iconTint="@color/text_primary"
                        app:cornerRadius="20dp"
                        app:iconSize="24dp"
                        android:layout_marginEnd="8dp"
                        style="@style/Widget.Material3.Button" />

                    <!-- Heart Icon (circular white button) -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnLike"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:insetLeft="0dp"
                        android:insetRight="0dp"
                        android:backgroundTint="@color/background_white"
                        app:icon="@drawable/ic_heart"
                        app:iconTint="@color/orange_primary"
                        app:cornerRadius="20dp"
                        app:iconSize="24dp"
                        style="@style/Widget.Material3.Button" />

                </LinearLayout>
            </FrameLayout>

            <!-- Information Card (60% of screen, overlaps bottom of image) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/infoCard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="-32dp"
                app:cardCornerRadius="@dimen/corner_radius_xl"
                app:cardElevation="@dimen/card_elevation_medium"
                app:cardBackgroundColor="@color/background_white"
                app:layout_constraintTop_toBottomOf="@id/imageSection"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="24dp">

                    <!-- Orange Pill Tag -->
                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipTag"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ISLAND ESCAPE"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_white"
                        android:backgroundTint="@color/orange_primary"
                        app:chipCornerRadius="16dp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />

                    <!-- Title -->
                    <TextView
                        android:id="@+id/tvTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Crystal Waters of Maya Bay"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginTop="16dp"
                        app:layout_constraintTop_toBottomOf="@id/chipTag"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <!-- Author Row -->
                    <LinearLayout
                        android:id="@+id/authorRow"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="16dp"
                        app:layout_constraintTop_toBottomOf="@id/tvTitle"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent">

                        <ImageView
                            android:id="@+id/ivUserProfile"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:scaleType="centerCrop"
                            android:src="@android:drawable/ic_menu_myplaces"
                            android:background="@drawable/profile_circle_background"
                            android:padding="2dp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="12dp">

                            <TextView
                                android:id="@+id/tvUsername"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Alex Wanderer"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="@color/text_primary" />

                            <TextView
                                android:id="@+id/tvLocationTime"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Maldives • 2 days ago"
                                android:textSize="12sp"
                                android:textColor="@color/text_secondary" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Description Text -->
                    <TextView
                        android:id="@+id/tvPostText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Post description text goes here..."
                        android:textSize="14sp"
                        android:textColor="@color/text_secondary"
                        android:lineSpacingExtra="4dp"
                        android:layout_marginTop="16dp"
                        app:layout_constraintTop_toBottomOf="@id/authorRow"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <!-- Comments Section -->
                    <TextView
                        android:id="@+id/tvCommentsLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Comments"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:layout_marginTop="20dp"
                        app:layout_constraintTop_toBottomOf="@id/tvPostText"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvComments"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        android:minHeight="80dp"
                        android:layout_marginTop="8dp"
                        app:layout_constraintTop_toBottomOf="@id/tvCommentsLabel"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <LinearLayout
                        android:id="@+id/commentInputRow"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="8dp"
                        app:layout_constraintTop_toBottomOf="@id/rvComments"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent">

                        <ImageButton
                            android:id="@+id/btnCommentPhoto"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:src="@drawable/ic_camera"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/add_photo"
                            android:tint="@color/orange_primary"
                            android:padding="8dp" />

                        <EditText
                            android:id="@+id/etComment"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:hint="Add a comment..."
                            android:inputType="textCapSentences|textMultiLine"
                            android:maxLines="3"
                            android:background="@drawable/white_rounded_square"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:textSize="14sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSendComment"
                            android:layout_width="wrap_content"
                            android:layout_height="44dp"
                            android:text="Send"
                            android:layout_marginStart="8dp"
                            app:cornerRadius="8dp"
                            style="@style/Widget.Material3.Button" />
                    </LinearLayout>

                    <!-- CURRENT WEATHER Section -->
                    <TextView
                        android:id="@+id/tvWeatherLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="CURRENT WEATHER"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_secondary"
                        android:textAllCaps="true"
                        android:letterSpacing="0.1"
                        android:layout_marginTop="24dp"
                        app:layout_constraintTop_toBottomOf="@id/commentInputRow"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/weatherCard"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        app:cardCornerRadius="@dimen/corner_radius_medium"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="@color/background_light"
                        app:layout_constraintTop_toBottomOf="@id/tvWeatherLabel"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:padding="16dp">

                            <!-- Temperature -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tvTemperature"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="28°C"
                                    android:textSize="32sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/text_primary" />

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal"
                                    android:gravity="center_vertical"
                                    android:layout_marginTop="4dp">

                                    <ImageView
                                        android:layout_width="16dp"
                                        android:layout_height="16dp"
                                        android:src="@drawable/ic_heart"
                                        android:tint="@color/orange_primary" />

                                    <TextView
                                        android:id="@+id/tvCondition"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Sunny"
                                        android:textSize="14sp"
                                        android:textColor="@color/text_secondary"
                                        android:layout_marginStart="4dp" />
                                </LinearLayout>
                            </LinearLayout>

                            <!-- Wind and Humidity -->
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:gravity="end">

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal"
                                    android:gravity="center_vertical"
                                    android:layout_marginBottom="8dp">

                                    <ImageView
                                        android:layout_width="16dp"
                                        android:layout_height="16dp"
                                        android:src="@drawable/ic_paper_airplane"
                                        android:tint="@color/text_secondary" />

                                    <TextView
                                        android:id="@+id/tvWind"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="12km/h"
                                        android:textSize="12sp"
                                        android:textColor="@color/text_secondary"
                                        android:layout_marginStart="4dp" />
                                </LinearLayout>

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal"
                                    android:gravity="center_vertical">

                                    <ImageView
                                        android:layout_width="16dp"
                                        android:layout_height="16dp"
                                        android:src="@drawable/ic_heart"
                                        android:tint="@color/text_secondary" />

                                    <TextView
                                        android:id="@+id/tvHumidity"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="64%"
                                        android:textSize="12sp"
                                        android:textColor="@color/text_secondary"
                                        android:layout_marginStart="4dp" />
                                </LinearLayout>
                            </LinearLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Location Section -->
                    <TextView
                        android:id="@+id/tvLocationLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Location"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:layout_marginTop="24dp"
                        app:layout_constraintTop_toBottomOf="@id/weatherCard"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/mapCard"
                        android:layout_width="0dp"
                        android:layout_height="180dp"
                        android:layout_marginTop="8dp"
                        app:cardCornerRadius="@dimen/corner_radius_medium"
                        app:cardElevation="0dp"
                        app:layout_constraintTop_toBottomOf="@id/tvLocationLabel"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent">

                        <com.google.android.gms.maps.MapView
                            android:id="@+id/mapView"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent" />
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Nearby Places Section -->
                    <TextView
                        android:id="@+id/tvNearbyPlacesLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="NEARBY PLACES"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_secondary"
                        android:textAllCaps="true"
                        android:letterSpacing="0.1"
                        android:layout_marginTop="24dp"
                        app:layout_constraintTop_toBottomOf="@id/mapCard"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvNearbyPlaces"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:nestedScrollingEnabled="false"
                        app:layout_constraintTop_toBottomOf="@id/tvNearbyPlacesLabel"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <!-- Pricing Section (Google price_level 0-4, only when available) -->
                    <LinearLayout
                        android:id="@+id/pricingSection"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="24dp"
                        android:visibility="gone"
                        app:layout_constraintTop_toBottomOf="@id/tvNearbyPlacesLabel"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Price level"
                            android:textSize="12sp"
                            android:textColor="@color/text_secondary" />

                        <TextView
                            android:id="@+id/tvPrice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary"
                            android:layout_marginStart="8dp" />
                    </LinearLayout>

                    <!-- Add to Trip Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAddToTrip"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:text="Add to Trip"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_white"
                        android:backgroundTint="@color/orange_primary"
                        app:cornerRadius="@dimen/corner_radius_medium"
                        android:layout_marginTop="24dp"
                        android:layout_marginBottom="24dp"
                        app:layout_constraintTop_toBottomOf="@id/pricingSection"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
