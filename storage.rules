rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Post, profile, and comment images.
    // Public read so Coil can load Firebase Storage download URLs on any device without auth headers.
    match /post_images/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /profile_images/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /comment_images/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
